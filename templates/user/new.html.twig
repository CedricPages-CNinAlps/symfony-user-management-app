{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-4">
        <h1 class="text-primary">Créer un utilisateur</h1>

        <div class="card p-4 shadow-sm">
            {{ form_start(form, {'attr': {'class': 'form'}}) }}

            <div class="mb-3">
                {{ form_label(form.firstname, 'Prénom', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.firstname, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.lastname, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.lastname, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.groupe, 'Groupe', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.groupe, {'attr': {'class': 'form-control'}}) }}
            </div>

            {{ form_end(form) }}
        </div>

        <a href="{{ path('users_list') }}" class="btn btn-secondary btn-sm mt-3">Retour à la liste</a>
    </div>
{% endblock %}
